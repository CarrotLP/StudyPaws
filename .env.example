# Copy this file to `.env` and fill in the real values.
# Get them from: Supabase Dashboard → your project → Project Settings → API
#
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time, so they
# ship to clients. The anon key is safe to expose (it's gated by RLS);
# the service-role key is NOT — never put it in an EXPO_PUBLIC_* var.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
